{
  "name": "@irrigacao/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . --noEmit && vite build",
    "build:campo-demo": "tsc -p . --noEmit && vite build --config vite.campo.config.ts --mode demo",
