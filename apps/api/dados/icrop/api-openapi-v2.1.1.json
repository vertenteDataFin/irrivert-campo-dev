   "get": {
    "tags": [
     "Apoio"
    ],
    "summary": "Baixar o limite da fazenda em KML",
    "description": "Converte o GeoJSON cadastrado na fazenda e retorna um arquivo KML.",
    "operationId": "geojson_to_kml",
    "parameters": [
     {
      "name": "id_fazenda",
      "in": "path",
      "description": "ID da fazenda a ser exportada",
      "required": true,
      "schema": {
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Arquivo KML gerado com sucesso.",
      "content": {
       "application/vnd.google-earth.kml+xml": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       }
      }
     },
     "403": {
      "description": "Falha de autenticação.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Erro"
        }
       }
      }
     },
     "422": {
      "description": "Fazenda inexistente, sem GeoJSON ou com GeoJSON inválido.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Erro"
        }
       }
      }
     },
     "500": {
      "description": "Erro interno. Consultar setor administrativo.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Erro"
        }
       }
      }
     }
    },
    "security": [
     {
      "Bearer": []
     }
    ]
   }
  }
